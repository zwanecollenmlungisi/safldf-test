<!DOCTYPE html>
<html>
<head>
    <title>Supabase Test</title>
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2">
    </script>
</head>
<body>
    <h1>🔌 Supabase Connection Test</h1>
    <button id="testBtn">Test Connection</button>
    <pre id="result" style="background:#f4f4f4; padding:12px; border-radius:8px; margin-top:12px;"></pre>

    <script>
        // --- YOUR SUPABASE CREDENTIALS ---
        const SUPABASE_URL = 'https://ucgsnkectmfbircexhmv.supabase.co';
        const SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InVjZ3Nua2VjdG1mYmlyY2V4aG12Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODY2MDg1NjEsImV4cCI6MjEwMjE4NDU2MX0.bMU5VNVgGzjPHeURH4h1phj62vrKQnSUEKF1txlLGV0';

        // --- INITIALIZE SUPABASE (ONLY ONCE) ---
        const supabaseClient = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
        console.log('✅ Supabase initialized');

        // --- GET THE BUTTON AND RESULT ELEMENT ---
        const btn = document.getElementById('testBtn');
        const resultEl = document.getElementById('result');

        // --- TEST FUNCTION ---
        btn.addEventListener('click', async function() {
            resultEl.textContent = '⏳ Testing connection...';
            try {
                const { data, error } = await supabaseClient.from('events').select('*');
                if (error) {
                    resultEl.textContent = '❌ Error: ' + error.message + '\n\n' + JSON.stringify(error, null, 2);
                } else {
                    resultEl.textContent = '✅ Success!\n\nData from "events" table:\n' + JSON.stringify(data, null, 2);
                }
            } catch (err) {
                resultEl.textContent = '❌ Exception: ' + err.message;
            }
        });
    </script>
</body>
</html>
